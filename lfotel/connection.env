export LANGFUSE_SECRET_KEY="TODO:replace-me"
export LANGFUSE_PUBLIC_KEY="TODO:replace-me"
export LANGFUSE_BASE_URL="http://localhost:3000"

export LANGFUSE_AUTH_STRING="$(
  printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" |
  base64 |
  tr -d '\r\n'
)"

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

export OTEL_TRACES_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# Export to the local collector, which remaps token attributes and forwards to Langfuse.
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
export OTEL_RESOURCE_ATTRIBUTES="session.tag=TODO:replace-me"

export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_ASSISTANT_RESPONSES=1
export OTEL_LOG_TOOL_DETAILS=1
export OTEL_LOG_TOOL_CONTENT=1